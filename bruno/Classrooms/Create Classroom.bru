meta {
  name: Create Classroom
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/classrooms
  body: json
  auth: none
}

body:json {
  {
    "schoolId": "{{schoolId}}",
    "name": "Turma A"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("classroomId", res.body.id);
}

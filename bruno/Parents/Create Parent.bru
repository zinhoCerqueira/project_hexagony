meta {
  name: Create Parent
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/parents
  body: json
  auth: none
}

body:json {
  {
    "name": "Maria Souza",
    "phone": "11999998888",
    "email": "maria.souza@mail.com",
    "schoolId": "{{schoolId}}"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("parentId", res.body.id);
}

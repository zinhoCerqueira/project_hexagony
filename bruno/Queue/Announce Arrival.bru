meta {
  name: Announce Arrival (Estou Chegando)
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/queue/announce
  body: json
  auth: none
}

body:json {
  {
    "schoolId": "{{schoolId}}",
    "studentId": "{{studentId}}",
    "parentId": "{{parentId}}",
    "latitude": -23.550520,
    "longitude": -46.633308
  }
}

assert {
  res.status: eq 200
  res.body.journeyStatus: eq EN_ROUTE
  res.body.currentRange: eq CLOSE
  res.body.called: eq true
}

script:post-response {
  bru.setVar("queueItemId", res.body.id);
}

docs {
  Contrato alinhado a `AnnounceArrivalUseCase.AnnounceArrivalCommand`
  (`src/main/java/com/schoolqueue/domain/ports/in/AnnounceArrivalUseCase.java`):
  `schoolId`, `studentId`, `parentId`, `latitude`, `longitude` (BigDecimal).
  GPS é obrigatório. O item nasce com `journeyStatus = EN_ROUTE` e o
  `currentRange` é calculado por `ProximityRange.fromCoordinates(...)` no
  service.

  Pendente: o `PickupQueueController` (roteiro, item "Fase 5: Adaptadores
  REST") ainda não foi implementado — este endpoint retorna 404 no estado
  atual do código. Quando entrar, esta coleção passa a ser executável ponta
  a ponta.
}

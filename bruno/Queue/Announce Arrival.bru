meta {
  name: Announce Arrival (Estou Chegando)
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/queue/announce
  body: json
  auth: none
}

body:json {
  {
    "schoolId": "{{schoolId}}",
    "studentId": "{{studentId}}",
    "parentId": "{{parentId}}",
    "latitude": -23.550520,
    "longitude": -46.633308
  }
}

assert {
  res.status: eq 200
  res.body.journeyStatus: eq EN_ROUTE
  res.body.currentRange: eq CLOSE
  res.body.called: eq true
}

script:post-response {
  bru.setVar("queueItemId", res.body.id);
}

docs {
  Anuncia a chegada do responsável e abre o item da fila em `EN_ROUTE`.
  Implementado pelo `PickupQueueController` usando `AnnounceArrivalUseCase`
  (`AnnounceArrivalService` + `QueueDtoMapper`).

  Contrato alinhado a `AnnounceArrivalUseCase.AnnounceArrivalCommand`
  (`src/main/java/com/schoolqueue/domain/ports/in/AnnounceArrivalUseCase.java`):
  `schoolId`, `studentId`, `parentId`, `latitude`, `longitude` (BigDecimal).
  GPS é obrigatório (`@NotNull` em `AnnounceArrivalRequest`).

  O `currentRange` é calculado por `ProximityRange.fromCoordinates(...)`
  (Haversine entre o GPS do responsável e o da escola): `CLOSE` (≤ 0,5 km)
  já nasce com `called = true`; `MEDIUM`/`FAR` nascem com `called = false`.
  Publica `queue.arrival.announced` no exchange `school.queue.events`
  (fila `queue.notifications`) e loga `Published arrival.announced`.

  Erros:
  - 400 quando `latitude`/`longitude` estão ausentes (bean validation) ou
    quando já existe item ativo para o `studentId` (handler
    `IllegalStateException`).
  - 404 quando a escola não existe (`SchoolNotFoundException`).
  - 409 quando o domínio rejeita o estado (`InvalidQueueStateException`).
}

meta {
  name: List Active Queue
  type: http
  seq: 2
}

get {
  url: http://localhost:8080/api/v1/queue/school/{{schoolId}}/active
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  Lista a fila ativa (status em `[EN_ROUTE, ARRIVED]`) da escola, ordenada
  por `createdAt` ascendente. Implementado pelo `PickupQueueController`
  (commit `feature/api02-pickup-queue-controller`, item `API02`) usando
  `FetchActiveQueueUseCase`. Body: lista de `QueueItemResponse` (11 campos
  cada, incluindo `called` e `currentRange`).
}

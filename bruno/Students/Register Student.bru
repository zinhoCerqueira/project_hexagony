meta {
  name: Register Student
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/v1/students
  body: json
  auth: none
}

body:json {
  {
    "schoolId": "{{schoolId}}",
    "classroomId": "{{classroomId}}",
    "name": "João Aluno Exemplo",
    "parentIds": ["{{parentId}}"]
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("studentId", res.body.id);
}
